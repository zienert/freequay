+static BOOL batch_disabled;
+
+static struct opengl_batch *get_batch(void)
+{
+    struct opengl_batch *batch = NtCurrentTeb()->glReserved1[WINE_GL_RESERVED_BATCH];
+
+    if (!batch && !batch_disabled && (batch = malloc( sizeof(*batch) )))
+    {
+        batch->used = 0;
+        batch->busy = FALSE;
+        NtCurrentTeb()->glReserved1[WINE_GL_RESERVED_BATCH] = batch;
+    }
+    return batch;
+}
+
+/* runs the entries on the Unix side, in one switch, and empties the batch */
+static NTSTATUS batch_run( struct opengl_batch *batch, UINT size )
+{
+    struct process_batch_params args = { .data = batch->data, .size = size };
+    NTSTATUS status;
+
+    batch->used = 0;
+    batch->busy = TRUE;
+    status = WINE_UNIX_CALL( unix_process_batch, &args );
+    batch->busy = FALSE;
+    return status;
+}
+
+BOOL batch_add( enum unix_funcs code, void *params )
+{
+    const struct batch_info *info = &batch_info[code];
+    struct opengl_batch *batch = get_batch();
+    UINT size = (info->size + 7) & ~7, values_size = 0;
+    struct opengl_batch_entry *entry;
+    const void *values = NULL;
+    BYTE *copy;
+
+    if (!batch || batch->busy) return FALSE;
+    if (info->value_size)
+    {
+        GLsizei count = *(const GLsizei *)((const BYTE *)params + info->count_offset);
+
+        /* odd counts go to the driver directly, for its error */
+        values = *(const void * const *)((const BYTE *)params + info->value_offset);
+        if (count <= 0 || count > 256 || !values) return FALSE;
+        values_size = count * info->value_size;
+    }
+    if (batch->used + sizeof(*entry) + size + values_size > sizeof(batch->data)) batch_run( batch, batch->used );
+
+    entry = (struct opengl_batch_entry *)((BYTE *)batch->data + batch->used);
+    copy = (BYTE *)(entry + 1);
+    memcpy( copy, params, info->size );
+    if (values_size)
+    {
+        memcpy( copy + size, values, values_size );
+        *(const void **)(copy + info->value_offset) = copy + size;
+        values_size = (values_size + 7) & ~7;
+    }
+    entry->code = code;
+    entry->size = size + values_size;
+    entry->params = (UINT_PTR)copy;
+    batch->used += sizeof(*entry) + entry->size;
+    return TRUE;
+}
+
+/* runs the collected calls and then this one, which ends the batch, in the same switch */
+NTSTATUS batch_flush( enum unix_funcs code, void *params )
+{
+    struct opengl_batch *batch = NtCurrentTeb()->glReserved1[WINE_GL_RESERVED_BATCH];
+    struct opengl_batch_entry *entry;
+
+    if (batch->used + sizeof(*entry) > sizeof(batch->data))
+    {
+        batch_run( batch, batch->used );
+        return WINE_UNIX_CALL( code, params );
+    }
+    entry = (struct opengl_batch_entry *)((BYTE *)batch->data + batch->used);
+    entry->code = code;
+    entry->size = 0;
+    entry->params = (UINT_PTR)params;
+    return batch_run( batch, batch->used + sizeof(*entry) );
+}
+
+static void batch_thread_detach(void)
+{
+    struct opengl_batch *batch = NtCurrentTeb()->glReserved1[WINE_GL_RESERVED_BATCH];
+
+    if (!batch) return;
+    if (batch->used && !batch->busy) batch_run( batch, batch->used );
+    NtCurrentTeb()->glReserved1[WINE_GL_RESERVED_BATCH] = NULL;
+    free( batch );
+}
