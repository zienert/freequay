+/* freequay: runs the OpenGL calls a 32-bit thread collected (wgl.c), in their order, and returns
+ * the status of the last one, the call that ended the batch */
+static NTSTATUS run_batch( const unixlib_entry_t *funcs, const char *data, UINT size )
+{
+    NTSTATUS status = STATUS_SUCCESS;
+    UINT pos = 0;
+
+    while (pos + sizeof(struct opengl_batch_entry) <= size)
+    {
+        const struct opengl_batch_entry *entry = (const struct opengl_batch_entry *)(data + pos);
 
+        if (entry->code >= funcs_count || entry->code == unix_process_batch)
+        {
+            ERR( "invalid call %u in batch\n", entry->code );
+            return STATUS_INVALID_PARAMETER;
+        }
+        status = funcs[entry->code]( (void *)(UINT_PTR)entry->params );
+        if (status && entry->size) WARN( "call %u in batch returned %#x\n", entry->code, (int)status );
+        pos += sizeof(*entry) + entry->size;
+    }
+    return status;
+}
+
+NTSTATUS process_batch( void *args )
+{
+    struct process_batch_params *params = args;
+
+    return run_batch( __wine_unix_call_funcs, params->data, params->size );
+}
