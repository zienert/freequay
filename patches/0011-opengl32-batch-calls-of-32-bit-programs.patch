+extern BOOL batch_add( enum unix_funcs code, void *params );
+extern NTSTATUS batch_flush( enum unix_funcs code, void *params );
+
+static inline NTSTATUS opengl_unix_call( enum unix_funcs code, void *params )
+{
+    struct opengl_batch *batch;
+
+    if (batch_info[code].size && batch_add( code, params )) return STATUS_SUCCESS;
+    if ((batch = NtCurrentTeb()->glReserved1[WINE_GL_RESERVED_BATCH]) && batch->used)
+        return batch_flush( code, params );
+    return WINE_UNIX_CALL( code, params );
+}
+
