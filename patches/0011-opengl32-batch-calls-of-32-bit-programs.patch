+/* freequay: the OpenGL calls a 32-bit thread collects before it switches to the Unix side (wgl.c) */
+struct opengl_batch
+{
+    UINT used;      /* bytes of entries in data */
+    BOOL busy;      /* the entries run: whatever is called meanwhile goes straight to the Unix side */
+    UINT64 data[(0x10000 - 8) / sizeof(UINT64)];
+};
